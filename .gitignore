# Terraform variable files (contain sensitive data like credentials)
terraform/*.tfvars
!terraform/terraform.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration files
.terraformrc
terraform.rc

# Crash log files
crash.log
crash.*.log

# Terraform lock file - SHOULD be committed (not ignored)
# terraform/.terraform.lock.hcl

